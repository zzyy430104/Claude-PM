DATABASE_URL=postgresql://pm:pm@localhost:5432/claude_pm
# 数据库连接池大小（每个进程），默认 10
# DATABASE_POOL_MAX=10
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
ALLOW_TENANT_SIGNUP=true
PORT=3000
# AI 接口地址允许的域名（逗号分隔，含子域名）；不设置时用内置清单：DeepSeek、通义千问、OpenAI、Kimi、智谱、火山方舟、千帆
# AI_ALLOWED_HOSTS=api.deepseek.com,dashscope.aliyuncs.com
# 私有部署用内网模型时设为 true：允许 http 和内网地址（地址仍须在 AI_ALLOWED_HOSTS 里）
# AI_ALLOW_PRIVATE=false
