// ───────── 改进方案第一步：需求与计划批准版本 ─────────

enum RequirementCategory {
  TIME
  COMMERCIAL
  TECHNICAL
  REGULATORY
  OTHER
}

enum RequirementStatus {
  OPEN
  VERIFIED
  NOT_APPLICABLE
}

/// 项目需求（8.1.3.1.1 a、8.1.3.3 a）：每条需求关联到交付物，便于检查覆盖和验证
model Requirement {
  id                 String              @id @default(uuid())
  tenantId           String              @map("tenant_id")
  projectId          String              @map("project_id")
  code               String
  title              String
  category           RequirementCategory
  /// 来源：合同条款、技术规格书章节等
  source             String              @default("")
  /// 验证方式：试验、检验、分析、评审等
  verificationMethod String              @default("") @map("verification_method")
  deliverableId      String?             @map("deliverable_id")
  status             RequirementStatus   @default(OPEN)
  note               String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  deliverable Deliverable? @relation(fields: [deliverableId], references: [id])

  @@unique([projectId, code])
  @@index([tenantId, projectId])
  @@map("requirements")
}

/// 计划批准版本：批准计划和每次实施范围 / 进度 / 预算 / 交期变更时保存的快照，作为计划与实际对比的依据
model PlanVersion {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  projectId       String   @map("project_id")
  version         Int
  changeRequestId String?  @map("change_request_id")
  note            String
  /// { project: { startDate, endDate, customerDeliveryDate, budget }, workPackages: [{ id, code, name, start, end, durationDays, budget }] }
  snapshot        Json
  createdById     String   @map("created_by_id")
  createdAt       DateTime @default(now())

  @@unique([projectId, version])
  @@index([tenantId, projectId])
  @@map("plan_versions")
}

// ───────── 改进方案第三步：补齐 ─────────

/// 标准 WBS 模板（8.1.3.3）：[{ code, name, durationDays, isMilestone, parentCode? }]
model WbsTemplate {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  items     Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([tenantId, name])
  @@map("wbs_templates")
}

/// 与客户和关键外部供方的 SWOT 评审（8.1.3.1.2 b）
model SwotReview {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  projectId     String   @map("project_id")
  reviewDate    DateTime @map("review_date") @db.Date
  participants  String
  strengths     String   @default("")
  weaknesses    String   @default("")
  opportunities String   @default("")
  threats       String   @default("")
  actions       String   @default("")
  createdById   String   @map("created_by_id")
  createdAt     DateTime @default(now())

  @@index([tenantId, projectId])
  @@map("swot_reviews")
}

enum DeviationDimension {
  QUALITY
  SCHEDULE
  COST
}

/// 偏离通报：即将偏离项目目标时，向客户和相关方通报影响与对策（8.1.3.8、8.1.3.11）
model DeviationNotice {
  id              String             @id @default(uuid())
  tenantId        String             @map("tenant_id")
  projectId       String             @map("project_id")
  dimension       DeviationDimension
  noticeDate      DateTime           @map("notice_date") @db.Date
  audience        String
  impact          String
  countermeasures String
  createdById     String             @map("created_by_id")
  createdAt       DateTime           @default(now())

  @@index([tenantId, projectId])
  @@map("deviation_notices")
}

/// 干系人登记册
model Stakeholder {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  projectId     String   @map("project_id")
  name          String
  organization  String   @default("")
  role          String   @default("")
  /// 影响力、关注度：HIGH / MEDIUM / LOW
  influence     String   @default("MEDIUM")
  interest      String   @default("MEDIUM")
  expectations  String   @default("")
  communication String   @default("")
  createdAt     DateTime @default(now())

  @@index([tenantId, projectId])
  @@map("stakeholders")
}

/// 职能角色字典：模板和项目引用角色本身，改名后各处同步显示新名称
model FunctionalRole {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  /// 标准费率（元 / 人天），工作包人工成本 = 人天 × 费率
  rate      Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("functional_roles")
}

enum ProjectType {
  A
  B
  C
}

enum InitiationStatus {
  DRAFT
  COSIGN
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ApprovalRoleKind {
  INITIATOR
  APPROVER
  COSIGNER
  PLAN_APPROVER
  /// 人事：查看和导出项目绩效评价单
  HR
}

enum RequirementChangeStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

/// 立项与审批角色：谁能提立项申请、谁批准、谁会签、谁批准计划；附授权依据和有效期
model ApprovalAssignment {
  id        String           @id @default(uuid())
  tenantId  String           @map("tenant_id")
  kind      ApprovalRoleKind
  userId    String           @map("user_id")
  /// 授权依据，如授权书编号
  basis     String           @default("")
  validFrom DateTime?        @map("valid_from") @db.Date
  validTo   DateTime?        @map("valid_to") @db.Date
  createdAt DateTime         @default(now())

  @@unique([tenantId, kind, userId])
  @@index([tenantId])
  @@map("approval_assignments")
}

/// 立项申请：批准后生成项目和项目要求第 1 版
model Initiation {
  id             String           @id @default(uuid())
  tenantId       String           @map("tenant_id")
  code           String
  projectCode    String           @default("") @map("project_code")
  name           String
  type           ProjectType      @default(B)
  riskLevel      RiskLevel        @default(MEDIUM) @map("risk_level")
  productFamily  String           @default("") @map("product_family")
  proposedPmId   String?          @map("proposed_pm_id")
  customer       String           @default("")
  contractNo     String           @default("") @map("contract_no")
  contractAmount Decimal?         @map("contract_amount") @db.Decimal(14, 2)
  startDate      DateTime?        @map("start_date") @db.Date
  /// 项目要求：时间、交付物、质量、成本、初步风险（见 initiations/requirements.ts）
  requirements   Json             @default("{}")
  status         InitiationStatus @default(DRAFT)
  applicantId    String           @map("applicant_id")
  submittedAt    DateTime?        @map("submitted_at")
  decidedById    String?          @map("decided_by_id")
  decidedAt      DateTime?        @map("decided_at")
  decisionNote   String?          @map("decision_note")
  projectId      String?          @map("project_id")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  opinions InitiationOpinion[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("initiations")
}

/// 会签意见
model InitiationOpinion {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  initiationId String   @map("initiation_id")
  userId       String   @map("user_id")
  agree        Boolean
  opinion      String
  createdAt    DateTime @default(now())

  initiation Initiation @relation(fields: [initiationId], references: [id])

  @@unique([initiationId, userId])
  @@index([tenantId])
  @@map("initiation_opinions")
}

/// 项目要求的各个版本：第 1 版来自立项，以后每版来自一次批准的项目要求变更
model ProjectRequirementVersion {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  projectId    String   @map("project_id")
  version      Int
  data         Json
  reason       String
  approvedById String   @map("approved_by_id")
  approvedAt   DateTime @default(now()) @map("approved_at")
  changeId     String?  @map("change_id")

  @@unique([projectId, version])
  @@index([tenantId, projectId])
  @@map("project_requirement_versions")
}

/// 项目要求变更：独立于项目内变更，由立项批准人审批
model RequirementChange {
  id           String                  @id @default(uuid())
  tenantId     String                  @map("tenant_id")
  projectId    String                  @map("project_id")
  code         String
  reason       String
  /// 变更后的完整项目要求
  data         Json
  fromVersion  Int                     @map("from_version")
  status       RequirementChangeStatus @default(DRAFT)
  applicantId  String                  @map("applicant_id")
  submittedAt  DateTime?               @map("submitted_at")
  decidedById  String?                 @map("decided_by_id")
  decidedAt    DateTime?               @map("decided_at")
  decisionNote String?                 @map("decision_note")
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, projectId])
  @@map("requirement_changes")
}

/// 可选工作包库：不是每个项目都有的环节，策划时勾选加入
model OptionalWorkPackage {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  name           String
  durationDays   Int      @map("duration_days")
  suggestedPhase String   @default("") @map("suggested_phase")
  roleName       String   @default("") @map("role_name")
  deliverable    String   @default("")
  types          String[] @default([])
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("optional_work_packages")
}

/// 企业改过的 A/B/C 计划模板；没有改过时使用系统默认模板
model PlanTypeTemplate {
  id        String      @id @default(uuid())
  tenantId  String      @map("tenant_id")
  type      ProjectType
  items     Json
  updatedAt DateTime    @updatedAt

  @@unique([tenantId, type])
  @@map("plan_type_templates")
}

/// 工作包的非人工费用（材料、外协、工装等），按成本科目归集
model WpCostLine {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  projectId     String   @map("project_id")
  workPackageId String   @map("work_package_id")
  accountId     String   @map("account_id")
  description   String   @default("")
  amount        Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now())

  workPackage WorkPackage @relation(fields: [workPackageId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId])
  @@map("wp_cost_lines")
}

/// 承诺成本：已下单、未结算的金额（采购计划下单时写入，也可手工登记；结算后登记负数冲减）
model CostCommitment {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  projectId     String   @map("project_id")
  workPackageId String?  @map("work_package_id")
  accountId     String   @map("account_id")
  amount        Decimal  @db.Decimal(14, 2)
  description   String
  entryDate     DateTime @map("entry_date") @db.Date
  /// 由采购计划下单产生（结算或取消时去掉）
  purchaseItemId String? @unique @map("purchase_item_id")
  createdById   String   @map("created_by_id")
  createdAt     DateTime @default(now())

  @@index([tenantId, projectId])
  @@map("cost_commitments")
}

enum InspectionResult {
  PENDING
  PASS
  FAIL
  NA
}

/// 工作包上的检验 / 验证项：产品、过程、文件、评审、试验或企业自定义类别
model InspectionItem {
  id            String            @id @default(uuid())
  tenantId      String            @map("tenant_id")
  projectId     String            @map("project_id")
  workPackageId String            @map("work_package_id")
  name          String
  category      String
  requirement   String            @default("")
  method        String            @default("")
  record        String            @default("")
  verifierId    String?           @map("verifier_id")
  isKey         Boolean           @default(false) @map("is_key")
  sortOrder     Int               @default(0) @map("sort_order")
  result        InspectionResult  @default(PENDING)
  /// 第一次给出的结果（合格 / 不合格），用于一次合格率
  firstResult   InspectionResult? @map("first_result")
  recordNo      String            @default("") @map("record_no")
  resultNote    String            @default("") @map("result_note")
  resultAt      DateTime?         @map("result_at")
  resultById    String?           @map("result_by_id")
  ncId          String?           @map("nc_id")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  workPackage WorkPackage @relation(fields: [workPackageId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId])
  @@index([workPackageId])
  @@map("inspection_items")
}

/// 企业检验项库：工作包里可直接选用
model InspectionTemplate {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  category    String
  requirement String   @default("")
  method      String   @default("")
  record      String   @default("")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("inspection_templates")
