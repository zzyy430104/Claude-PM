generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLATFORM_ADMIN
  TENANT_ADMIN
  TOP_MANAGEMENT
  FUNCTION_MANAGER
  PROJECT_MANAGER
  PROJECT_QUALITY_MANAGER
  WORK_PACKAGE_OWNER
  MEMBER
}

model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  /// 挣值预警阈值：SPI / CPI 低于 amber 为黄，低于 red 为红
  evmAmber             Decimal    @default(0.95) @map("evm_amber") @db.Decimal(4, 2)
  evmRed               Decimal    @default(0.90) @map("evm_red") @db.Decimal(4, 2)
  /// 工作日历：每周上班的日子（1 = 周一 … 7 = 周日）、放假日、调休上班日
  workWeek             Int[]      @default([1, 2, 3, 4, 5]) @map("work_week")
  holidays             Json       @default("[]")
  extraWorkdays        Json       @default("[]") @map("extra_workdays")
  /// 顶栏和工作台显示的系统名称，企业可以改
  systemName           String     @default("Claude-PM") @map("system_name")
  /// 立项需要会签（质量、财务等先给意见）
  requireCosign        Boolean    @default(false) @map("require_cosign")
  /// 小项目免立项：项目经理可直接建项目
  allowDirectProject   Boolean    @default(false) @map("allow_direct_project")
  /// 风险评价：可能性、影响各分几档（3 或 5）；矩阵 [可能性][影响] → 0 低 / 1 中 / 2 高
  riskScale            Int        @default(3) @map("risk_scale")
  riskMatrix           Json       @default("[[0,0,1],[0,1,2],[1,2,2]]") @map("risk_matrix")
  /// 各目标维度的影响判断标准 { 交期: [低, 中, 高], … }、应对策略清单、按层级 × 重要度的规则
  riskCriteria         Json       @default("{}") @map("risk_criteria")
  riskStrategies       Json       @default("{}") @map("risk_strategies")
  riskRules            Json       @default("{}") @map("risk_rules")
  /// 项目绩效评价设置：项目经理评价方面与权重、计分规则、成员评价维度、等级、可见范围（空 = 默认）
  perfConfig           Json       @default("{}") @map("perf_config")
  /// 检验 / 验证项的类别，企业可以增减
  inspectionCategories String[]   @default(["产品", "过程", "文件", "评审", "试验"]) @map("inspection_categories")
  users                User[]
  auditLogs            AuditLog[]

  @@map("tenants")
}

model User {
  id                 String    @id @default(uuid())
  tenantId           String?   @map("tenant_id")
  email              String
  name               String
  passwordHash       String    @map("password_hash")
  /// 管理员设置或重置的密码，本人下次登录后必须修改
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  passwordChangedAt  DateTime? @map("password_changed_at")
  role               Role
  /// 职能角色（企业自定义名称，如 工艺、质量、采购），用于模板和计划里按角色指定责任人
  functionalRoleId   String?   @map("functional_role_id")
  /// 所属部门（项目绩效评价单发给部门负责人）
  departmentId       String?   @map("department_id")
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  refreshTokens RefreshToken[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?  @map("tenant_id")
  actorId   String?  @map("actor_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ───────── 批次 B：项目、阶段、WBS ─────────

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  CLOSED
  CANCELLED
}

enum ProjectRole {
  PROJECT_MANAGER
  PROJECT_QUALITY_MANAGER
  WORK_PACKAGE_OWNER
  FUNCTION_MANAGER
  MEMBER
}

enum PhaseStatus {
  PLANNED
  ACTIVE
  CLOSED
}

enum WpStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  VERIFIED
}

enum DeliverableKind {
  INTERNAL
  CUSTOMER_APPROVAL
  EXTERNAL_PROVIDER
  CUSTOMER_SUPPLIED
}

enum DeliverableStatus {
  PLANNED
  SUBMITTED
  ACCEPTED
  REJECTED
}

model PhaseTemplate {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  /// [{ name, checklist: string[], mandatoryRoles: ProjectRole[] }]，按顺序
  phases    Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([tenantId, name])
  @@map("phase_templates")
}

model Project {
  id                   String        @id @default(uuid())
  tenantId             String        @map("tenant_id")
  code                 String
  name                 String
  description          String?
  riskLevel            RiskLevel     @default(MEDIUM)
  status               ProjectStatus @default(PLANNING)
  /// 项目类型：A 含产品设计开发；B 基于客户合同；C 按库存计划
  type                 ProjectType   @default(B)
  /// 由哪份立项申请批准生成；为空表示直接建立（小项目免立项）
  initiationId         String?       @map("initiation_id")
  /// 当前生效的项目要求版本（0 = 没有项目要求）
  requirementVersion   Int           @default(0) @map("requirement_version")
  /// 项目要求变更后、计划重新批准前为 true
  planOutdated         Boolean       @default(false) @map("plan_outdated")
  /// 最近一次发给管理层的总预算报警（RED），避免重复
  costAlert            String?       @map("cost_alert")
  /// 项目经理提交计划批准的时间（批准或退回后清空）
  planSubmittedAt      DateTime?     @map("plan_submitted_at")
  /// 基线后，范围 / 预算 / 客户交期只能通过已批准的变更申请修改
  baselined            Boolean       @default(false)
  /// 阶段评审从哪一级 WBS 开始（8.1.3.1.3 c），1 = 顶层
  gateReviewWbsLevel   Int           @default(1) @map("gate_review_wbs_level")
  startDate            DateTime      @db.Date
  endDate              DateTime      @db.Date
  customerDeliveryDate DateTime?     @db.Date
  budget               Decimal?      @db.Decimal(14, 2)
  reviewIntervalDays   Int           @default(30)
  createdById          String        @map("created_by_id")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  members      ProjectMember[]
  phases       Phase[]
  workPackages WorkPackage[]
  plan         ProjectPlan?
  deliverables Deliverable[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("projects")
}

model ProjectMember {
  id           String      @id @default(uuid())
  tenantId     String      @map("tenant_id")
  projectId    String      @map("project_id")
  userId       String      @map("user_id")
  projectRole  ProjectRole
  /// 变更控制委员会（CCB）成员
  isCcb        Boolean     @default(false)
  /// 任命书编号或说明
  appointment  String?
  competencies String?
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id])

  @@unique([projectId, userId])
  @@index([tenantId, userId])
  @@map("project_members")
}

model ProjectPlan {
  projectId        String   @id @map("project_id")
  tenantId         String   @map("tenant_id")
  objectives       String   @default("")
  frameConditions  String   @default("")
  exclusions       String   @default("")
  responsibilities String   @default("")
  executionRules   String   @default("")
  /// [{ userId, role, reportsToUserId? }]
  orgChart         Json     @default("[]")
  /// 多场地 / 联合体：工作分工、接口、沟通渠道
  interfaces       Json     @default("{}")
  version          Int      @default(1)
  updatedById      String   @map("updated_by_id")
  updatedAt        DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])

  @@map("project_plans")
}

model Phase {
  id             String      @id @default(uuid())
  tenantId       String      @map("tenant_id")
  projectId      String      @map("project_id")
  name           String
  order          Int
  status         PhaseStatus @default(PLANNED)
  checklist      Json        @default("[]")
  mandatoryRoles Json        @default("[]") @map("mandatory_roles")
  /// 可选参与者角色（8.1.3.1.3）
  optionalRoles  Json        @default("[]") @map("optional_roles")
  startedAt      DateTime?
  closedAt       DateTime?

  project      Project       @relation(fields: [projectId], references: [id])
  workPackages WorkPackage[]
  deliverables Deliverable[]

  @@unique([projectId, order])
  @@index([tenantId, projectId])
  @@map("phases")
}

model WorkPackage {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  projectId          String    @map("project_id")
  parentId           String?   @map("parent_id")
  phaseId            String?   @map("phase_id")
  code               String
  name               String
  description        String?
  ownerId            String?   @map("owner_id")
  durationDays       Int       @default(1) @map("duration_days")
  actualStart        DateTime? @db.Date
  actualEnd          DateTime? @db.Date
  percentComplete    Int       @default(0) @map("percent_complete")
  status             WpStatus  @default(NOT_STARTED)
  verifiedById       String?   @map("verified_by_id")
  verifiedAt         DateTime?
  budget             Decimal?  @db.Decimal(14, 2)
  /// 预算归入的成本科目（8.1.3.5 b）
  costAccountId      String?   @map("cost_account_id")
  /// 产出的交付物（8.1.3.1.1 d）
  deliverableId      String?   @map("deliverable_id")
  /// 估算资源（人天，8.1.3.4 b）
  resourceDays       Decimal?  @map("resource_days") @db.Decimal(10, 1)
  /// 外部供方名称：由外部供方完成的工作包（8.1.3.4 d）
  externalProvider   String?   @map("external_provider")
  /// 长周期物料，需与外部供方共同管理（8.1.3.4 c2）
  longLead           Boolean   @default(false) @map("long_lead")
  /// 里程碑：工期为 0 的节点（客户验收点、关口等）
  isMilestone        Boolean   @default(false) @map("is_milestone")
  /// 责任角色（职能角色字典），按角色批量指定责任人
  functionalRoleId   String?   @map("functional_role_id")
  /// 采购工作包：采购是跨阶段的工作线
  isPurchase         Boolean   @default(false) @map("is_purchase")
  /// 手工改的人工费率（为空时用职能角色的标准费率）及原因
  laborRate          Decimal?  @map("labor_rate") @db.Decimal(10, 2)
  laborRateReason    String?   @map("labor_rate_reason")
  /// 负责人估计的完工尚需成本；为空时按 预算 × 剩余比例 − 承诺 推算
  estimateToComplete Decimal?  @map("estimate_to_complete") @db.Decimal(14, 2)
  /// 最近一次发出的超支提醒级别（AMBER / RED），避免重复提醒
  costAlert          String?   @map("cost_alert")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project      Project          @relation(fields: [projectId], references: [id])
  phase        Phase?           @relation(fields: [phaseId], references: [id])
  costAccount  CostAccount?     @relation(fields: [costAccountId], references: [id])
  deliverable  Deliverable?     @relation(fields: [deliverableId], references: [id])
  parent       WorkPackage?     @relation("WbsTree", fields: [parentId], references: [id])
  children     WorkPackage[]    @relation("WbsTree")
  predecessors WpDependency[]   @relation("Successor")
  successors   WpDependency[]   @relation("Predecessor")
  costLines    WpCostLine[]
  inspections  InspectionItem[]

  @@unique([projectId, code])
  @@index([tenantId, projectId])
  @@map("work_packages")
}

model WpDependency {
  id            String @id @default(uuid())
  tenantId      String @map("tenant_id")
  projectId     String @map("project_id")
  predecessorId String @map("predecessor_id")
  successorId   String @map("successor_id")

  predecessor WorkPackage @relation("Predecessor", fields: [predecessorId], references: [id])
  successor   WorkPackage @relation("Successor", fields: [successorId], references: [id])

  @@unique([predecessorId, successorId])
  @@index([projectId])
  @@map("wp_dependencies")
}

model Deliverable {
  id        String            @id @default(uuid())
  tenantId  String            @map("tenant_id")
  projectId String            @map("project_id")
  phaseId   String?           @map("phase_id")
  name      String
  kind      DeliverableKind
  supplier  String?
  dueDate   DateTime?         @db.Date
  status    DeliverableStatus @default(PLANNED)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  project      Project       @relation(fields: [projectId], references: [id])
  phase        Phase?        @relation(fields: [phaseId], references: [id])
  workPackages WorkPackage[]
  requirements Requirement[]

  @@index([tenantId, projectId])
  @@map("deliverables")
}

// ───────── 批次 C：评审、变更、风险、问题 ─────────

enum GateStatus {
  OPEN
  DECIDED
}

enum GateDecision {
  APPROVED
  CONDITIONAL
  REJECTED
}

enum IssueKind {
  ISSUE
  ACTION
}

enum IssueStatus {
  OPEN
  CLOSED
}

enum ChangeType {
  SCOPE
  SCHEDULE
  BUDGET
  DELIVERY_DATE
  TECHNICAL
  OTHER
}

enum ChangeStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  IMPLEMENTED
  VERIFIED
  CLOSED
}

enum RiskKind {
  RISK
  OPPORTUNITY
}

enum RiskStatus {
  OPEN
  MITIGATING
  /// 措施已全部完成，等待复评
  REVIEW
  OCCURRED
  CLOSED
}

enum RiskLevel3 {
  ENTERPRISE
  PROJECT
  WORK_PACKAGE
}

model GateReview {
  id                     String        @id @default(uuid())
  tenantId               String        @map("tenant_id")
  projectId              String        @map("project_id")
  phaseId                String        @map("phase_id")
  status                 GateStatus    @default(OPEN)
  decision               GateDecision?
  /// [{ item, passed, comment? }]
  checklistResults       Json          @default("[]")
  /// 出席者 userId 列表
  attendees              Json          @default("[]")
  notes                  String?
  decisionNote           String?
  decidedById            String?       @map("decided_by_id")
  decidedAt              DateTime?
  /// 带着未关闭问题通过时，由最高管理层授权
  overrideAuthorizedById String?       @map("override_authorized_by_id")
  overrideReason         String?
  escalated              Boolean       @default(false)
  createdById            String        @map("created_by_id")
  createdAt              DateTime      @default(now())

  @@index([tenantId, projectId])
  @@index([phaseId])
  @@map("gate_reviews")
}

model ProjectReview {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  projectId    String    @map("project_id")
  reviewDate   DateTime  @db.Date
  attendees    Json      @default("[]")
  /// 评审时的绩效快照：计划与实际进度、预测完工日等
  performance  Json
  notes        String?
  /// 提交上级决策或升级的事项
  escalations  String?
  reportedToId String?   @map("reported_to_id")
  reportedAt   DateTime?
  createdById  String    @map("created_by_id")
  createdAt    DateTime  @default(now())

  @@index([tenantId, projectId])
  @@map("project_reviews")
}

model Issue {
  id              String      @id @default(uuid())
  tenantId        String      @map("tenant_id")
  projectId       String      @map("project_id")
  kind            IssueKind
  title           String
  description     String?
  status          IssueStatus @default(OPEN)
  ownerId         String?     @map("owner_id")
  dueDate         DateTime?   @db.Date
  /// GATE | PROJECT_REVIEW | RISK | MANUAL
  source          String      @default("MANUAL")
  gateReviewId    String?     @map("gate_review_id")
  projectReviewId String?     @map("project_review_id")
  riskId          String?     @map("risk_id")
  phaseId         String?     @map("phase_id")
  closedAt        DateTime?
  closedById      String?     @map("closed_by_id")
  closureNote     String?
  createdById     String      @map("created_by_id")
  createdAt       DateTime    @default(now())

  @@index([tenantId, projectId, status])
  @@map("issues")
}

model ChangeRequest {
  id                 String       @id @default(uuid())
  tenantId           String       @map("tenant_id")
  projectId          String       @map("project_id")
  code               String
  type               ChangeType
  title              String
  description        String
  reason             String
  triggeredByFailure Boolean      @default(false)
  causeAnalysis      String?
  impactAnalysis     String?
  verificationPlan   String?
  /// 技术变更的影响分析：已交付部件、客户规格与配置、相关文件、技术要求、再验证
  technicalImpact    Json?
  /// 拟变更内容：{ budget?, customerDeliveryDate?, startDate?, endDate? }
  proposed           Json?
  customerNotifiedAt DateTime?
  customerAgreedAt   DateTime?
  status             ChangeStatus @default(DRAFT)
  requestedById      String       @map("requested_by_id")
  submittedAt        DateTime?
  decidedById        String?      @map("decided_by_id")
  decidedAt          DateTime?
  decisionNote       String?
  implementedById    String?      @map("implemented_by_id")
  implementedAt      DateTime?
  verifiedById       String?      @map("verified_by_id")
  verifiedAt         DateTime?
  effectivenessNote  String?
  closedAt           DateTime?
  createdAt          DateTime     @default(now())

  @@unique([projectId, code])
  @@index([tenantId, projectId])
  @@map("change_requests")
}

model Risk {
  id                  String     @id @default(uuid())
  tenantId            String     @map("tenant_id")
  /// 企业级风险不属于某个项目（受影响的项目见 RiskProjectLink）
  projectId           String?    @map("project_id")
  kind                RiskKind
  title               String
  description         String?
  /// 1–5
  probability         Int
  /// 1–5
  impact              Int
  /// 风险的潜在损失，或机会的潜在收益
  exposureAmount      Decimal    @default(0) @map("exposure_amount") @db.Decimal(14, 2)
  /// 应对措施成本
  responseCost        Decimal    @default(0) @map("response_cost") @db.Decimal(14, 2)
  costBenefitAnalysis String     @default("") @map("cost_benefit_analysis")
  /// 与客户商定的产品成熟度（作为风险输入，8.1.3.9.2 b）
  maturityLevel       String?    @map("maturity_level")
  /// 参与风险评审的职能经理（8.1.3.9.2 a）
  functionalReviewers String?    @map("functional_reviewers")
  /// 机会：可用于弥补预算损失的金额（8.1.3.9.2 c）
  budgetRecovery      Decimal?   @map("budget_recovery") @db.Decimal(14, 2)
  ownerId             String?    @map("owner_id")
  status              RiskStatus @default(OPEN)
  closureNote         String?
  lastReviewedAt      DateTime?
  createdById         String     @map("created_by_id")
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  /// 层级：企业级 / 项目级 / 工作包级，决定审批、关闭和监控的人
  level               RiskLevel3 @default(PROJECT)
  workPackageId       String?    @map("work_package_id")
  /// 影响的项目目标
  objectiveId         String?    @map("objective_id")
  cause               String     @default("")
  effect              String     @default("")
  /// 应对策略：风险 消除 / 转移 / 减弱 / 接受；机会 利用 / 分享 / 提高 / 接受（企业可改名）
  strategy            String?
  acceptReason        String?    @map("accept_reason")
  contingencyPlan     String?    @map("contingency_plan")
  acceptApprovedById  String?    @map("accept_approved_by_id")
  acceptApprovedAt    DateTime?  @map("accept_approved_at")
  /// 预警条件（人工判断是否触发）
  trigger             String     @default("")
  triggeredAt         DateTime?  @map("triggered_at")
  reviewCycleDays     Int?       @map("review_cycle_days")
  nextReviewAt        DateTime?  @map("next_review_at") @db.Date
  residualProbability Int?       @map("residual_probability")
  residualImpact      Int?       @map("residual_impact")
  closedById          String?    @map("closed_by_id")
  closedAt            DateTime?  @map("closed_at")
  /// 最近一次通知的重要度，用于“变成高风险时通知管理层”
  notifiedLevel       String?    @map("notified_level")

  links    RiskProjectLink[]
  measures RiskMeasure[]
  reviews  RiskReview[]

  @@index([tenantId, projectId])
  @@index([tenantId, level])
  @@map("risks")
}

// ───────── 批次 D：成本、质量、沟通与培训 ─────────

enum NcSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum NcStatus {
  OPEN
  ANALYSIS
  ACTION
  VERIFICATION
  CLOSED
}

enum NcSource {
  INSPECTION
  AUDIT
  CUSTOMER
  SUPPLIER
  OTHER
}

enum CommKind {
  MEETING
  CUSTOMER
  SUPPLIER
  INTERNAL
}

enum TrainingStatus {
  PLANNED
  DONE
}

model CostAccount {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  projectId          String   @map("project_id")
  code               String
  name               String
  budget             Decimal  @db.Decimal(14, 2)
  /// 人工估算的完工尚需成本（ETC）；为空则按 预算 − 已发生 推算
  estimateToComplete Decimal? @map("estimate_to_complete") @db.Decimal(14, 2)
  /// 人工科目：工作包按 人天 × 费率 算出的人工成本归入这里
  isLabor            Boolean  @default(false) @map("is_labor")
  createdAt          DateTime @default(now())

  entries      CostEntry[]
  workPackages WorkPackage[]

  @@unique([projectId, code])
  @@index([tenantId, projectId])
  @@map("cost_accounts")
}

