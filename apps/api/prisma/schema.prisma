}

// ───────── 批次 E：文档、经验教训、配置、投标 ─────────

enum LessonKind {
  GOOD_PRACTICE
  LESSON
}

enum ConfigKind {
  HARDWARE
  SOFTWARE
  DOCUMENT
  TOOL
}

enum BaselineType {
