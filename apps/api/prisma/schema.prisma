generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLATFORM_ADMIN
  TENANT_ADMIN
  TOP_MANAGEMENT
  FUNCTION_MANAGER
  PROJECT_MANAGER
  PROJECT_QUALITY_MANAGER
  WORK_PACKAGE_OWNER
  MEMBER
}

model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  users     User[]
  auditLogs AuditLog[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String?  @map("tenant_id")
  email        String
  name         String
  passwordHash String   @map("password_hash")
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  refreshTokens RefreshToken[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?  @map("tenant_id")
  actorId   String?  @map("actor_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ───────── 批次 B：项目、阶段、WBS ─────────

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  CLOSED
  CANCELLED
}

enum ProjectRole {
  PROJECT_MANAGER
  PROJECT_QUALITY_MANAGER
  WORK_PACKAGE_OWNER
  FUNCTION_MANAGER
  MEMBER
}

enum PhaseStatus {
  PLANNED
  ACTIVE
  CLOSED
}

enum WpStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  VERIFIED
}

enum DeliverableKind {
  INTERNAL
  CUSTOMER_APPROVAL
  EXTERNAL_PROVIDER
  CUSTOMER_SUPPLIED
}

enum DeliverableStatus {
  PLANNED
  SUBMITTED
  ACCEPTED
  REJECTED
}

model PhaseTemplate {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  /// [{ name, checklist: string[], mandatoryRoles: ProjectRole[] }]，按顺序
  phases    Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([tenantId, name])
  @@map("phase_templates")
}

model Project {
  id                   String        @id @default(uuid())
  tenantId             String        @map("tenant_id")
  code                 String
  name                 String
  description          String?
  riskLevel            RiskLevel     @default(MEDIUM)
  status               ProjectStatus @default(PLANNING)
  /// 基线后，范围 / 预算 / 客户交期只能通过已批准的变更申请修改
  baselined            Boolean       @default(false)
  startDate            DateTime      @db.Date
  endDate              DateTime      @db.Date
  customerDeliveryDate DateTime?     @db.Date
  budget               Decimal?      @db.Decimal(14, 2)
  reviewIntervalDays   Int           @default(30)
  createdById          String        @map("created_by_id")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  members      ProjectMember[]
  phases       Phase[]
  workPackages WorkPackage[]
  plan         ProjectPlan?
  deliverables Deliverable[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("projects")
}

model ProjectMember {
  id           String      @id @default(uuid())
  tenantId     String      @map("tenant_id")
  projectId    String      @map("project_id")
  userId       String      @map("user_id")
  projectRole  ProjectRole
  /// 变更控制委员会（CCB）成员
  isCcb        Boolean     @default(false)
  /// 任命书编号或说明
  appointment  String?
  competencies String?
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id])

  @@unique([projectId, userId])
  @@index([tenantId, userId])
  @@map("project_members")
}

model ProjectPlan {
  projectId        String   @id @map("project_id")
  tenantId         String   @map("tenant_id")
  objectives       String   @default("")
  frameConditions  String   @default("")
  exclusions       String   @default("")
  responsibilities String   @default("")
  executionRules   String   @default("")
  /// [{ userId, role, reportsToUserId? }]
  orgChart         Json     @default("[]")
  /// 多场地 / 联合体：工作分工、接口、沟通渠道
  interfaces       Json     @default("{}")
  version          Int      @default(1)
  updatedById      String   @map("updated_by_id")
  updatedAt        DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])

  @@map("project_plans")
}

model Phase {
  id             String      @id @default(uuid())
  tenantId       String      @map("tenant_id")
  projectId      String      @map("project_id")
  name           String
  order          Int
  status         PhaseStatus @default(PLANNED)
  checklist      Json        @default("[]")
  mandatoryRoles Json        @default("[]") @map("mandatory_roles")
  startedAt      DateTime?
  closedAt       DateTime?

  project      Project       @relation(fields: [projectId], references: [id])
  workPackages WorkPackage[]
  deliverables Deliverable[]

  @@unique([projectId, order])
  @@index([tenantId, projectId])
  @@map("phases")
}

model WorkPackage {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  projectId       String    @map("project_id")
  parentId        String?   @map("parent_id")
  phaseId         String?   @map("phase_id")
  code            String
  name            String
  description     String?
  ownerId         String?   @map("owner_id")
  durationDays    Int       @default(1) @map("duration_days")
  actualStart     DateTime? @db.Date
  actualEnd       DateTime? @db.Date
  percentComplete Int       @default(0) @map("percent_complete")
  status          WpStatus  @default(NOT_STARTED)
  verifiedById    String?   @map("verified_by_id")
  verifiedAt      DateTime?
  budget          Decimal?  @db.Decimal(14, 2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project      Project        @relation(fields: [projectId], references: [id])
  phase        Phase?         @relation(fields: [phaseId], references: [id])
  parent       WorkPackage?   @relation("WbsTree", fields: [parentId], references: [id])
  children     WorkPackage[]  @relation("WbsTree")
  predecessors WpDependency[] @relation("Successor")
  successors   WpDependency[] @relation("Predecessor")

  @@unique([projectId, code])
  @@index([tenantId, projectId])
  @@map("work_packages")
}

model WpDependency {
  id            String @id @default(uuid())
  tenantId      String @map("tenant_id")
  projectId     String @map("project_id")
  predecessorId String @map("predecessor_id")
  successorId   String @map("successor_id")

  predecessor WorkPackage @relation("Predecessor", fields: [predecessorId], references: [id])
  successor   WorkPackage @relation("Successor", fields: [successorId], references: [id])

  @@unique([predecessorId, successorId])
  @@index([projectId])
  @@map("wp_dependencies")
}

model Deliverable {
  id        String            @id @default(uuid())
  tenantId  String            @map("tenant_id")
  projectId String            @map("project_id")
  phaseId   String?           @map("phase_id")
  name      String
  kind      DeliverableKind
  supplier  String?
  dueDate   DateTime?         @db.Date
  status    DeliverableStatus @default(PLANNED)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  project Project @relation(fields: [projectId], references: [id])
  phase   Phase?  @relation(fields: [phaseId], references: [id])

  @@index([tenantId, projectId])
  @@map("deliverables")
}

// ───────── 批次 C：评审、变更、风险、问题 ─────────

enum GateStatus {
  OPEN
  DECIDED
}

enum GateDecision {
  APPROVED
  CONDITIONAL
  REJECTED
}

enum IssueKind {
  ISSUE
  ACTION
}

enum IssueStatus {
  OPEN
  CLOSED
}

enum ChangeType {
  SCOPE
  SCHEDULE
  BUDGET
  DELIVERY_DATE
  TECHNICAL
  OTHER
}

enum ChangeStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  IMPLEMENTED
  VERIFIED
  CLOSED
}

enum RiskKind {
  RISK
  OPPORTUNITY
}

enum RiskStatus {
  OPEN
  MITIGATING
  OCCURRED
  CLOSED
}

model GateReview {
  id                     String        @id @default(uuid())
  tenantId               String        @map("tenant_id")
  projectId              String        @map("project_id")
  phaseId                String        @map("phase_id")
  status                 GateStatus    @default(OPEN)
  decision               GateDecision?
  /// [{ item, passed, comment? }]
  checklistResults       Json          @default("[]")
  /// 出席者 userId 列表
  attendees              Json          @default("[]")
  notes                  String?
  decisionNote           String?
  decidedById            String?       @map("decided_by_id")
  decidedAt              DateTime?
  /// 带着未关闭问题通过时，由最高管理层授权
  overrideAuthorizedById String?       @map("override_authorized_by_id")
  overrideReason         String?
  escalated              Boolean       @default(false)
  createdById            String        @map("created_by_id")
  createdAt              DateTime      @default(now())

  @@index([tenantId, projectId])
  @@index([phaseId])
  @@map("gate_reviews")
}

model ProjectReview {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  projectId    String    @map("project_id")
  reviewDate   DateTime  @db.Date
  attendees    Json      @default("[]")
  /// 评审时的绩效快照：计划与实际进度、预测完工日等
  performance  Json
  notes        String?
  /// 提交上级决策或升级的事项
  escalations  String?
  reportedToId String?   @map("reported_to_id")
  reportedAt   DateTime?
  createdById  String    @map("created_by_id")
  createdAt    DateTime  @default(now())

  @@index([tenantId, projectId])
  @@map("project_reviews")
}

model Issue {
  id              String      @id @default(uuid())
  tenantId        String      @map("tenant_id")
  projectId       String      @map("project_id")
  kind            IssueKind
  title           String
  description     String?
  status          IssueStatus @default(OPEN)
  ownerId         String?     @map("owner_id")
  dueDate         DateTime?   @db.Date
  /// GATE | PROJECT_REVIEW | RISK | MANUAL
  source          String      @default("MANUAL")
  gateReviewId    String?     @map("gate_review_id")
  projectReviewId String?     @map("project_review_id")
  riskId          String?     @map("risk_id")
  phaseId         String?     @map("phase_id")
  closedAt        DateTime?
  closedById      String?     @map("closed_by_id")
  closureNote     String?
  createdById     String      @map("created_by_id")
  createdAt       DateTime    @default(now())

  @@index([tenantId, projectId, status])
  @@map("issues")
}

model ChangeRequest {
  id                 String       @id @default(uuid())
  tenantId           String       @map("tenant_id")
  projectId          String       @map("project_id")
  code               String
  type               ChangeType
  title              String
  description        String
  reason             String
  triggeredByFailure Boolean      @default(false)
  causeAnalysis      String?
  impactAnalysis     String?
  verificationPlan   String?
  /// 技术变更的影响分析：已交付部件、客户规格与配置、相关文件、技术要求、再验证
  technicalImpact    Json?
  /// 拟变更内容：{ budget?, customerDeliveryDate?, startDate?, endDate? }
  proposed           Json?
  customerNotifiedAt DateTime?
  customerAgreedAt   DateTime?
  status             ChangeStatus @default(DRAFT)
  requestedById      String       @map("requested_by_id")
  submittedAt        DateTime?
  decidedById        String?      @map("decided_by_id")
  decidedAt          DateTime?
  decisionNote       String?
  implementedById    String?      @map("implemented_by_id")
  implementedAt      DateTime?
  verifiedById       String?      @map("verified_by_id")
  verifiedAt         DateTime?
  effectivenessNote  String?
  closedAt           DateTime?
  createdAt          DateTime     @default(now())

  @@unique([projectId, code])
  @@index([tenantId, projectId])
  @@map("change_requests")
}

model Risk {
  id                  String     @id @default(uuid())
  tenantId            String     @map("tenant_id")
  projectId           String     @map("project_id")
  kind                RiskKind
  title               String
  description         String?
  /// 1–5
  probability         Int
  /// 1–5
  impact              Int
  /// 风险的潜在损失，或机会的潜在收益
  exposureAmount      Decimal    @map("exposure_amount") @db.Decimal(14, 2)
  /// 应对措施成本
  responseCost        Decimal    @map("response_cost") @db.Decimal(14, 2)
  costBenefitAnalysis String     @map("cost_benefit_analysis")
  ownerId             String?    @map("owner_id")
  status              RiskStatus @default(OPEN)
  closureNote         String?
  lastReviewedAt      DateTime?
  createdById         String     @map("created_by_id")
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([tenantId, projectId])
  @@map("risks")
}

// ───────── 批次 D：成本、质量、沟通与培训 ─────────

enum NcSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum NcStatus {
  OPEN
  ANALYSIS
  ACTION
  VERIFICATION
  CLOSED
}

enum NcSource {
  INSPECTION
  AUDIT
  CUSTOMER
  SUPPLIER
  OTHER
}

enum CommKind {
  MEETING
  CUSTOMER
  SUPPLIER
  INTERNAL
}

enum TrainingStatus {
  PLANNED
  DONE
}

model CostAccount {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  projectId          String   @map("project_id")
  code               String
  name               String
  budget             Decimal  @db.Decimal(14, 2)
  /// 人工估算的完工尚需成本（ETC）；为空则按 预算 − 已发生 推算
  estimateToComplete Decimal? @map("estimate_to_complete") @db.Decimal(14, 2)
  createdAt          DateTime @default(now())

  entries CostEntry[]

  @@unique([projectId, code])
  @@index([tenantId, projectId])
  @@map("cost_accounts")
}

/// 成本记录只增不改：更正通过录入负数冲销
model CostEntry {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  projectId   String   @map("project_id")
  accountId   String   @map("account_id")
  amount      Decimal  @db.Decimal(14, 2)
  entryDate   DateTime @db.Date
  description String
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now())

  account CostAccount @relation(fields: [accountId], references: [id])

  @@index([tenantId, projectId])
  @@map("cost_entries")
}

model QualityPlan {
  projectId    String    @id @map("project_id")
  tenantId     String    @map("tenant_id")
  objectives   String    @default("")
  procedures   String    @default("")
  /// [{ kind: 'QA' | 'QC', name, phaseId?, method, frequency, responsibleId? }]
  activities   Json      @default("[]")
  version      Int       @default(1)
  approvedById String?   @map("approved_by_id")
  approvedAt   DateTime?
  updatedById  String    @map("updated_by_id")
  updatedAt    DateTime  @updatedAt

  @@map("quality_plans")
}

model Nonconformity {
  id                String     @id @default(uuid())
  tenantId          String     @map("tenant_id")
  projectId         String     @map("project_id")
  code              String
  title             String
  description       String
  severity          NcSeverity
  source            NcSource
  status            NcStatus   @default(OPEN)
  phaseId           String?    @map("phase_id")
  workPackageId     String?    @map("work_package_id")
  detectedById      String     @map("detected_by_id")
  detectedAt        DateTime   @default(now())
  containment       String?
  rootCause         String?
  correctiveAction  String?
  preventiveAction  String?
  actionOwnerId     String?    @map("action_owner_id")
  actionDueDate     DateTime?  @db.Date
  actionCompletedAt DateTime?
  effectivenessNote String?
  changeRequestId   String?    @map("change_request_id")
  verifiedById      String?    @map("verified_by_id")
  closedAt          DateTime?
  createdAt         DateTime   @default(now())

  @@unique([projectId, code])
  @@index([tenantId, projectId, status])
  @@map("nonconformities")
}

model CommunicationPlan {
  projectId   String   @id @map("project_id")
  tenantId    String   @map("tenant_id")
  /// [{ audience, channel, frequency, ownerId? }]
  channels    Json     @default("[]")
  notes       String   @default("")
  version     Int      @default(1)
  updatedById String   @map("updated_by_id")
  updatedAt   DateTime @updatedAt

  @@map("communication_plans")
}

model CommunicationLog {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  projectId    String   @map("project_id")
  kind         CommKind
  logDate      DateTime @map("log_date") @db.Date
  subject      String
  participants String   @default("")
  summary      String
  createdById  String   @map("created_by_id")
  createdAt    DateTime @default(now())

  @@index([tenantId, projectId])
  @@map("communication_logs")
}

model Training {
  id          String         @id @default(uuid())
  tenantId    String         @map("tenant_id")
  projectId   String         @map("project_id")
  userId      String         @map("user_id")
  title       String
  dueDate     DateTime?      @db.Date
  status      TrainingStatus @default(PLANNED)
  completedAt DateTime?
  createdById String         @map("created_by_id")
  createdAt   DateTime       @default(now())

  @@index([tenantId, projectId])
  @@map("trainings")
}
