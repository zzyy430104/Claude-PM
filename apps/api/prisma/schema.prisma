/// 风险复查记录
model RiskReview {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  riskId       String   @map("risk_id")
  reviewedById String   @map("reviewed_by_id")
  probability  Int
  impact       Int
  note         String
  createdAt    DateTime @default(now())

  risk Risk @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@index([tenantId, riskId])
  @@map("risk_reviews")
}

enum ObjectiveMetric {
  DELIVERY
  COST
  FAI
  FIRST_PASS_YIELD
  MANUAL
}

/// 项目目标：由项目要求生成（交期、成本、质量），项目经理可补充自定义目标
model ProjectObjective {
  id          String          @id @default(uuid())
  tenantId    String          @map("tenant_id")
  projectId   String          @map("project_id")
  /// 维度：交期 / 成本 / 质量 / 客户 / 其他，用于选影响的判断标准
  dimension   String
  name        String
  target      String
  metric      ObjectiveMetric @default(MANUAL)
  /// 自定义目标的当前值和状态（GREEN / AMBER / RED / 空），由项目经理更新
  current     String          @default("")
  manualState String?         @map("manual_state")
  /// 由项目要求生成的目标随项目要求变更自动更新
  auto        Boolean         @default(false)
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now())

  @@index([tenantId, projectId])
  @@map("project_objectives")
}

// ───────── 第 5C 章：项目绩效评价 ─────────

/// 部门及负责人（成员的项目绩效评价单发给所在部门负责人）
model Department {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  headId    String?  @map("head_id")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("departments")
}

/// 项目经理绩效：本项目的权重、实际交付日期、管理层评语与调整
model ProjectPerformance {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  projectId      String    @unique @map("project_id")
  /// 本项目的评价方面与权重 [{ key, name, weight }]；为空时用企业默认
  aspects        Json?
  aspectsReason  String?   @map("aspects_reason")
  /// 实际交付（入库）日期；为空时按交付物验收或排程推算
  actualDelivery DateTime? @map("actual_delivery") @db.Date
  /// 自定义方面的分数 { key: 0–100 }
  manualScores   Json      @default("{}") @map("manual_scores")
  adjustedScore  Int?      @map("adjusted_score")
  adjustReason   String?   @map("adjust_reason")
  comment        String?
  confirmedAt    DateTime? @map("confirmed_at")
  confirmedById  String?   @map("confirmed_by_id")
  /// 确认时的计算结果（确认后不再随数据变化）
  snapshot       Json?
  updatedAt      DateTime  @updatedAt

  @@index([tenantId])
  @@map("project_performances")
}

enum EvaluationStatus {
  DRAFT
  SUBMITTED
}

/// 项目经理对项目成员的评价（只针对本项目）
model MemberEvaluation {
  id          String           @id @default(uuid())
  tenantId    String           @map("tenant_id")
  projectId   String           @map("project_id")
  userId      String           @map("user_id")
  evaluatorId String           @map("evaluator_id")
  /// 在本项目的角色（职能角色或项目角色）
  roleName    String           @default("") @map("role_name")
  /// 提交时的参考数据
  reference   Json             @default("{}")
  /// { 维度: 1–5 }
  scores      Json             @default("{}")
  score       Int              @default(0)
  grade       String           @default("")
  comment     String           @default("")
  status      EvaluationStatus @default(DRAFT)
  /// 提交次数（修改须重新提交）
  version     Int              @default(0)
  submittedAt DateTime?        @map("submitted_at")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([projectId, userId])
  @@index([tenantId, userId])
  @@map("member_evaluations")
}

// ───────── 第 3 步：采购计划、FAI、售后交接 ─────────

/// 采购计划（每个项目一份，批准后修订需重新批准）
model PurchasePlan {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  projectId    String    @unique @map("project_id")
  /// 已批准的版本号（0 = 从未批准）
  version      Int       @default(0)
  approvedAt   DateTime? @map("approved_at")
  approvedById String?   @map("approved_by_id")
  /// 批准后又有修改，待重新批准
  dirty        Boolean   @default(false)
  updatedAt    DateTime  @updatedAt

  @@index([tenantId])
  @@map("purchase_plans")
}

enum PurchaseStatus {
  PLANNED
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

/// 采购计划的物料行
model PurchaseItem {
  id            String         @id @default(uuid())
  tenantId      String         @map("tenant_id")
  projectId     String         @map("project_id")
  code          String
  name          String
  supplier      String         @default("")
  quantity      String         @default("")
  /// 需求（到货）日期
  needDate      DateTime?      @map("need_date") @db.Date
  /// 最晚下单日期；为空时按需求日期判断逾期
  orderBy       DateTime?      @map("order_by") @db.Date
  longLead      Boolean        @default(false) @map("long_lead")
  workPackageId String?        @map("work_package_id")
  /// 记到哪个成本科目（下单时生成承诺成本）
  accountId     String?        @map("account_id")
  amount        Decimal        @default(0) @db.Decimal(14, 2)
  status        PurchaseStatus @default(PLANNED)
  orderNo       String?        @map("order_no")
  orderedAt     DateTime?      @map("ordered_at") @db.Date
  /// 到货比例 0–100
  receivedPct   Int            @default(0) @map("received_pct")
  receivedAt    DateTime?      @map("received_at") @db.Date
  /// 已结算（转为实际成本）
  settledAt     DateTime?      @map("settled_at")
  notes         String         @default("")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([projectId, code])
  @@index([tenantId, projectId])
  @@map("purchase_items")
}

enum FaiResult {
  PASS
  CONDITIONAL
  FAIL
}

/// FAI 首件鉴定记录：只记结论和追溯信息，报告本身按企业现有方式编制保存
model FaiRecord {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  projectId      String    @map("project_id")
  reportNo       String    @map("report_no")
  date           DateTime  @db.Date
  /// 产品 / 零件号
  part           String
  result         FaiResult
  witnessed      Boolean   @default(false)
  /// 见证人（客户代表）
  witness        String    @default("")
  /// 报告存放位置
  location       String    @default("")
  notes          String    @default("")
  createdById    String    @map("created_by_id")
  createdAt      DateTime  @default(now())

  @@unique([projectId, reportNo])
  @@index([tenantId, projectId])
  @@map("fai_records")
}

enum HandoverStatus {
  DRAFT
  PENDING
  CONFIRMED
}

/// 售后交接
model Handover {
  id            String         @id @default(uuid())
  tenantId      String         @map("tenant_id")
  projectId     String         @unique @map("project_id")
  date          DateTime?      @db.Date
  fromId        String?        @map("from_id")
  /// 接收人（系统用户，需在系统里确认）
  receiverId    String?        @map("receiver_id")
  /// 外部接收人姓名（由项目经理登记签字交接单）
  externalName  String         @default("") @map("external_name")
  warrantyFrom  DateTime?      @map("warranty_from") @db.Date
  warrantyTo    DateTime?      @map("warranty_to") @db.Date
  documents     Json           @default("[]")
  openIssues    String         @default("") @map("open_issues")
  status        HandoverStatus @default(DRAFT)
  submittedAt   DateTime?      @map("submitted_at")
  confirmedAt   DateTime?      @map("confirmed_at")
  confirmedById String?        @map("confirmed_by_id")
  confirmNote   String         @default("") @map("confirm_note")
  updatedAt     DateTime       @updatedAt

  @@index([tenantId])
  @@map("handovers")
}
