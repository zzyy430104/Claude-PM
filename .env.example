# 复制为 .env 后修改所有 change-me。.env 不要提交到版本库。
POSTGRES_PASSWORD=change-me
# API 运行时使用的受限数据库账号密码（首次初始化数据库时创建，见 db/init/01-app-role.sh）
APP_DB_PASSWORD=change-me-too
# 用 openssl rand -hex 32 生成
JWT_SECRET=change-me-to-a-long-random-string
# 私有部署通常关闭自助注册，由平台管理员创建租户
ALLOW_TENANT_SIGNUP=false
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=change-me-as-well

# 站点对外地址，邮件里的链接会用到，例如 https://pm.example.com
APP_URL=http://localhost:8080
# 站点通过 https 访问时设为 true（刷新令牌 Cookie 带 Secure 标记）；纯 http 内网试运行设为 false
COOKIE_SECURE=false
# 对外端口
WEB_PORT=8080
# 邮件通知（可选）：smtp://用户:密码@主机:端口；留空则只发站内通知
SMTP_URL=
MAIL_FROM=Claude-PM <no-reply@example.com>
